# =======================================================
# VAIP Core - Template Seguro de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA compartilhe ou suba o arquivo .env no Git.
# =======================================================

# 1. Chaves de IA
GEMINI_API_KEY=""

# 2. Notificações e Mensagens (WhatsApp / Telegram / Discord / E-mail)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""

# 3. Plataformas de Vagas (Credenciais ou Cookies de Sessão Seguros)
LINKEDIN_SESSION_COOKIE=""
GUPY_USER_EMAIL=""

# 4. APIs de Mídia / Canais Dark (YouTube / TikTok / Kwai)
YOUTUBE_CLIENT_SECRETS_FILE="credentials/youtube_secret.json"
TIKTOK_ACCESS_TOKEN=""
KWAI_ACCESS_TOKEN=""

# 5. Configurações Regionais de Busca
TARGET_CITY="Mogi das Cruzes"
TARGET_STATE="SP"
TARGET_ROLES="Data Analyst, Analista de Dados, Engenheiro de Dados, Cientista de Dados"
